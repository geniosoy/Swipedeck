      { "label": "Deafen", "icon": "headphones", "color": "#B3261E", "action": { "type": "hotkey", "keys": "ctrl+shift+f14" } },
      { "label": "Switcher", "icon": "exchange", "action": { "type": "hotkey", "keys": "ctrl+k" } },
